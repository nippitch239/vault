# Backend (Lambda) configuration.
# In AWS these are Lambda environment variables. Secrets are NOT stored here: the Lambda
# reads them from AWS Secrets Manager via the Interface VPC Endpoint.

NODE_ENV=production

# --- Database (Amazon RDS PostgreSQL) ---
# ARN of the RDS-managed master secret ({ "username", "password" })
DB_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:rds!db-xxxxxxxx
DB_HOST=securevault-db.xxxxxxxx.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=securevault
# TLS to RDS is verified with the CA bundle shipped in the Lambda Node.js runtime
NODE_EXTRA_CA_CERTS=/var/runtime/ca-cert.pem
DB_POOL_MAX=2
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=8000

# --- Application secret ({ "saltPepper": "<random 32+ bytes>" }) ---
APP_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:securevault/app-xxxxxx

# --- CORS: the Amplify domain(s), comma separated ---
CORS_ALLOW_ORIGIN=https://main.d1234abcd.amplifyapp.com

# Cognito group whose members get the admin role
COGNITO_ADMIN_GROUP=admin

# --- Local development only (npm run dev --workspace backend) ---
# Leave DB_SECRET_ARN/DATABASE_URL unset to use the local SQLite file (data.sqlite).
# DATABASE_URL=postgres://vault:vault@localhost:5432/securevault
# DB_SSL=false
# SALT_PEPPER=local-dev-only
# LOCAL_ADMIN_USERS=alice            # usernames that get the "admin" group in the emulator
# LOCAL_AUTH_SECRET=                  # fixed signing key so local tokens survive restarts
# PORT=3000
