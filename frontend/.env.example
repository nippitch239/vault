# Frontend (Vite) configuration.
# Local:   cp frontend/.env.example frontend/.env.local   (values below work with `npm run dev`)
# Amplify: set the same names in Amplify Console -> App settings -> Environment variables.
# Only public identifiers belong here — never secrets (everything VITE_* ends up in the JS bundle).

# API Gateway invoke URL including the stage and /api/v1.
# Local dev uses the Vite proxy to the backend simulator on :3000.
VITE_API_URL=/api/v1
# Amplify example:
# VITE_API_URL=https://abc123defg.execute-api.ap-southeast-1.amazonaws.com/prod/api/v1

# "local" = backend Cognito emulator (dev only), "cognito" = Amazon Cognito.
VITE_AUTH_MODE=local

# Amazon Cognito user pool (required when VITE_AUTH_MODE=cognito)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Local Cognito emulator base path (dev only)
VITE_LOCAL_AUTH_URL=/local-auth
