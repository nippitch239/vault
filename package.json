{
  "name": "securevault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure Vault Cloud - Zero-Knowledge Cloud-Native Password Manager",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present && npm run test:integration",
    "test:shared": "npm test --workspace shared",
    "test:backend": "npm test --workspace backend",
    "test:frontend": "npm test --workspace frontend",
    "test:integration": "node --test integration/*.test.js",
    "verify": "node scripts/verify.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
